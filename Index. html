
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Inflation Auction Game | ECON 2301</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f1f4f9;color:#202b3c}
header{background:#172b4d;color:white;text-align:center;padding:28px 15px}
header h1{margin:0 0 8px}
header p{margin:0;color:#dce6f5}
main{max-width:760px;margin:28px auto;padding:0 16px}
.card{background:white;padding:23px;margin-bottom:18px;border-radius:12px;box-shadow:0 2px 12px #0000000c}
h2{margin-top:0}
label{display:block;font-weight:bold;margin:15px 0 7px}
input,select{width:100%;padding:12px;border:1px solid #cbd3df;border-radius:7px;font-size:16px}
button{padding:12px 18px;margin-top:14px;border:0;border-radius:7px;background:#1769aa;color:white;font-size:16px;cursor:pointer}
button:disabled{opacity:.5;cursor:not-allowed}
.secondary{background:#53657d}
.status{background:#edf3fa;padding:12px;border-radius:7px;margin:12px 0}
.hidden{display:none}
.muted{color:#65748b}
footer{text-align:center;padding:25px;color:#718096}
pre{white-space:pre-wrap;overflow-wrap:anywhere}
</style>
</head>
<body>

<header>
<h1>Inflation Auction Game</h1>
<p>Principles of Macroeconomics · ECON 2301</p>
</header>

<main>

<section class="card">
<h2>Welcome to the Auction!</h2>
<div id="roundStatus" class="status">Connecting to game...</div>
<p id="budgetText" class="muted">Your virtual budget will appear here.</p>
<p id="gameMessage" class="muted">Wait for your instructor to open the auction.</p>
<button class="secondary" id="refreshGameButton">Refresh Game Status</button>
</section>

<section class="card" id="joinCard">
<h2>Join the Game</h2>
<label for="studentName">Enter your name</label>
<input id="studentName" maxlength="40" placeholder="Your name">
<button id="joinButton">Join Auction</button>
</section>

<section class="card hidden" id="bidCard">
<h2>Place Your Bid</h2>
<p class="muted">Choose one item and submit one sealed bid for this round.</p>

<label for="goodSelect">Select an item</label>
<select id="goodSelect"></select>

<label for="bidAmount">Your bid ($)</label>
<input id="bidAmount" type="number" min="1" step="1" placeholder="Enter amount">

<button id="bidButton">Submit Bid</button>
<div id="bidMessage" class="status hidden"></div>
</section>

<section class="card hidden" id="studentStatusCard">
<h2>Your Participation</h2>
<div id="studentStatus" class="status"></div>
</section>

<section class="card">
<h2>Instructor Dashboard</h2>
<p class="muted">Instructor-only controls.</p>

<button class="secondary" id="showInstructor">Instructor Login</button>

<div id="instructorLogin" class="hidden">
<label for="instructorPin">Instructor PIN</label>
<input id="instructorPin" type="password" placeholder="Enter PIN">
<button id="instructorButton">Login</button>
<div id="instructorMessage" class="status hidden"></div>
</div>

<div id="instructorPanel" class="hidden">
<h3>Game Controls</h3>

<label for="roundSelect">Select auction round</label>
<select id="roundSelect"></select>

<div id="instructorStatus" class="status"></div>

<button id="startRoundButton">Open Selected Round</button>
<button class="secondary" id="closeRoundButton">Close Selected Round</button>
<button class="secondary" id="refreshResultsButton">Refresh Results</button>

<h3>Auction Results</h3>
<pre id="results"></pre>
</div>
</section>

</main>

<footer>Inflation Auction Game · Economics Classroom Activity</footer>

<script>
/* SUPABASE CONFIGURATION */
const SUPABASE_URL = "https://ubmazautxotaebousysc.supabase.co";
const SUPABASE_KEY = "sb_publishable_EqWIEuoflBQ8_q-LycbVjA__OyySvHF";
const FUNCTION_BASE = SUPABASE_URL + "/functions/v1/";

let db = null;
let currentRound = null;
let currentRounds = [];
let currentGoods = [];
let studentSession = null;
let instructorPin = null;

const $ = id => document.getElementById(id);

function showMessage(id, text) {
  $(id).textContent = text;
  $(id).classList.remove("hidden");
}

async function callFunction(name, payload = {}) {
  const response = await fetch(FUNCTION_BASE + name, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "apikey": SUPABASE_KEY,
      "Authorization": "Bearer " + SUPABASE_KEY
    },
    body: JSON.stringify(payload)
  });

  const data = await response.json().catch(() => ({}));

  if (!response.ok) {
    throw new Error(data.error || "Request failed.");
  }

  return data;
}

function selectedRoundId() {
  return $("roundSelect").value;
}

async function loadGame() {
  try {
    const { data: rounds, error: roundsError } = await db
      .from("auction_rounds")
      .select("*")
      .order("round_number");

    if (roundsError) throw roundsError;

    const { data: goods, error: goodsError } = await db
      .from("auction_goods")
      .select("*")
      .order("name");

    if (goodsError) throw goodsError;

    currentRounds = rounds || [];
    currentGoods = goods || [];
    currentRound = currentRounds.find(r => r.status === "open") || null;

    // Update instructor round selector.
    const previousSelection = $("roundSelect").value;
    $("roundSelect").innerHTML = "";

    currentRounds.forEach(round => {
      const option = document.createElement("option");
      option.value = round.id;
      option.textContent =
        "Round " + round.round_number +
        " — $" + round.student_budget +
        " — " + round.status.toUpperCase();
      $("roundSelect").appendChild(option);
    });

    if (currentRounds.some(r => String(r.id) === previousSelection)) {
      $("roundSelect").value = previousSelection;
    }

    // Update student-facing status.
    if (currentRound) {
      $("roundStatus").textContent =
        "Round " + currentRound.round_number + " is OPEN";

      $("budgetText").textContent =
        "Your virtual budget: $" + currentRound.student_budget;

      $("gameMessage").textContent =
        "Choose one item and submit your sealed bid.";

      $("bidCard").classList.toggle("hidden", !studentSession);
    } else {
      $("roundStatus").textContent =
        "No auction round is currently open.";

      $("budgetText").textContent = "Wait for your instructor.";

      $("gameMessage").textContent =
        "The auction is currently closed.";

      $("bidCard").classList.add("hidden");
    }

    // Populate goods.
    $("goodSelect").innerHTML = "";

    currentGoods.forEach(good => {
      const option = document.createElement("option");
      option.value = good.id;
      option.textContent = good.name;
      $("goodSelect").appendChild(option);
    });

    if (studentSession) {
      $("joinCard").classList.add("hidden");
      $("studentStatusCard").classList.remove("hidden");
    }

    if (instructorPin) {
      updateInstructorStatus();
    }

  } catch (error) {
    $("roundStatus").textContent =
      "Could not connect to the game: " + error.message;

    console.error(error);
  }
}

function updateInstructorStatus() {
  const round = currentRounds.find(
    r => String(r.id) === selectedRoundId()
  );

  if (!round) {
    $("instructorStatus").textContent = "No round selected.";
    return;
  }

  $("instructorStatus").textContent =
    "Selected: Round " + round.round_number +
    " | Budget: $" + round.student_budget +
    " | Status: " + round.status.toUpperCase();
}

async function joinGame() {
  const name = $("studentName").value.trim();

  if (name.length < 2) {
    alert("Please enter a name with at least two characters.");
    return;
  }

  $("joinButton").disabled = true;

  try {
    const result = await callFunction("student-register", {
      display_name: name
    });

    studentSession = result;

    sessionStorage.setItem(
      "auctionStudentSession",
      JSON.stringify(result)
    );

    $("joinCard").classList.add("hidden");
    $("studentStatusCard").classList.remove("hidden");

    $("studentStatus").textContent =
      "Welcome, " + result.display_name + "! You have joined the auction.";

    await loadGame();

  } catch (error) {
    alert(error.message);
  } finally {
    $("joinButton").disabled = false;
  }
}

async function submitBid() {
  if (!studentSession) {
    alert("Please join the game first.");
    return;
  }

  if (!currentRound) {
    alert("There is no open auction round.");
    return;
  }

  const amount = Number($("bidAmount").value);
  const goodId = $("goodSelect").value;

  if (
    !Number.isInteger(amount) ||
    amount <= 0 ||
    amount > Number(currentRound.student_budget)
  ) {
    alert(
      "Enter a whole-dollar bid between $1 and $" +
      currentRound.student_budget + "."
    );
    return;
  }

  $("bidButton").disabled = true;

  try {
    await callFunction("submit-bid", {
      access_token: studentSession.access_token,
      round_id: currentRound.id,
      good_id: goodId,
      bid_amount: amount
    });

    showMessage("bidMessage", "Your bid has been submitted successfully!");

    $("bidAmount").value = "";

    $("studentStatus").textContent =
      "Your bid for Round " + currentRound.round_number +
      " has been submitted. You cannot submit another bid in this round.";

  } catch (error) {
    showMessage("bidMessage", error.message);
  } finally {
    $("bidButton").disabled = false;
  }
}

async function instructorLogin() {
  $("instructorButton").disabled = true;

  try {
    const pin = $("instructorPin").value;

    await callFunction("instructor-login", { pin });

    // Keep PIN in memory only. It is not saved in local storage.
    instructorPin = pin;

    $("instructorLogin").classList.add("hidden");
    $("instructorPanel").classList.remove("hidden");

    $("instructorStatus").textContent =
      "Instructor access granted.";

    await loadGame();
    updateInstructorStatus();
    await refreshResults();

  } catch (error) {
    showMessage("instructorMessage", error.message);
  } finally {
    $("instructorButton").disabled = false;
  }
}

async function instructorAction(action) {
  if (!instructorPin) {
    alert("Please log in first.");
    return;
  }

  const roundId = selectedRoundId();

  if (!roundId) {
    alert("Please select a round.");
    return;
  }

  const actionText = action === "open" ? "open" : "close";

  if (!confirm("Are you sure you want to " + actionText + " this round?")) {
    return;
  }

  try {
    await callFunction("instructor-control", {
      pin: instructorPin,
      round_id: roundId,
      action: action
    });

    await loadGame();
    updateInstructorStatus();
    await refreshResults();

    alert("Round successfully " + actionText + "ed.");

  } catch (error) {
    alert(error.message);
  }
}

async function refreshResults() {
  if (!instructorPin) return;

  const roundId = selectedRoundId();

  if (!roundId) {
    $("results").textContent = "Select a round to view results.";
    return;
  }

  try {
    const data = await callFunction("instructor-results", {
      pin: instructorPin,
      round_id: roundId
    });

    $("results").textContent = JSON.stringify(data, null, 2);

  } catch (error) {
    $("results").textContent = error.message;
  }
}

// Event listeners
$("joinButton").addEventListener("click", joinGame);
$("bidButton").addEventListener("click", submitBid);

$("showInstructor").addEventListener("click", () => {
  $("instructorLogin").classList.toggle("hidden");
});

$("instructorButton").addEventListener("click", instructorLogin);

$("startRoundButton").addEventListener("click", () =>
  instructorAction("open")
);

$("closeRoundButton").addEventListener("click", () =>
  instructorAction("close")
);

$("refreshResultsButton").addEventListener("click", async () => {
  await loadGame();
  await refreshResults();
});

$("refreshGameButton").addEventListener("click", loadGame);

$("roundSelect").addEventListener("change", async () => {
  updateInstructorStatus();
  await refreshResults();
});

// Restore student session.
try {
  studentSession = JSON.parse(
    sessionStorage.getItem("auctionStudentSession") || "null"
  );

  if (studentSession) {
    $("joinCard").classList.add("hidden");
    $("studentStatusCard").classList.remove("hidden");
    $("studentStatus").textContent =
      "Welcome back, " + studentSession.display_name + ".";
  }
} catch (error) {
  studentSession = null;
}

// Initialize Supabase.
db = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
loadGame();

</script>
</body>
</html>
